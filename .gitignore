# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
build/
/coverage/
coverage/

# Ephemeral platform runner state regenerated by `flutter create`/`pod
# install` - never hand-authored, always safe to regenerate.
**/ephemeral/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# tool/ml/train_classifier.py is run in a local venv; the venv and its
# bytecode cache are never checked in (the trained model outputs under
# assets/model/ are - see README "Retraining the classifier").
.venv/
__pycache__/
*.pyc

# Generic dependency/build-artifact hygiene, kept broad in case
# supporting tooling (scripts, CI helpers) is added later. Anchored with
# a trailing slash where the name could otherwise collide with a
# source directory.
node_modules/
target/
dist/
.next/
bin/
obj/
*.duckdb
dbt_packages/
logs/
.env
.env.*
